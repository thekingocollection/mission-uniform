# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Never expose service_role/secret key in NEXT_PUBLIC variables.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET_IF_NEEDED

# Razorpay subject-wise Premium (use Test Mode keys before Live Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=SERVER_ONLY_RAZORPAY_SECRET

# Optional AI feature
OPENAI_API_KEY=
# Optional scheduled publishing protection
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
